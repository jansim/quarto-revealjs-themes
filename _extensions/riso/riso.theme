{
  "text-color": "#F3EEE3",
  "background-color": "#0B5594",
  "line-number-color": "#A9C8E8",
  "text-styles": {
    "Keyword": {"text-color": "#FF9BD2", "bold": true},
    "ControlFlow": {"text-color": "#FF9BD2", "bold": true},
    "Import": {"text-color": "#FF9BD2", "bold": true},
    "DataType": {"text-color": "#FFE36E"},
    "BuiltIn": {"text-color": "#FFFFFF", "bold": true},
    "Function": {"text-color": "#FFFFFF", "bold": true},
    "Extension": {"text-color": "#FFFFFF", "bold": true},
    "String": {"text-color": "#FFE36E"},
    "VerbatimString": {"text-color": "#FFE36E"},
    "SpecialString": {"text-color": "#FFE36E"},
    "Char": {"text-color": "#FFE36E"},
    "SpecialChar": {"text-color": "#FF9BD2"},
    "DecVal": {"text-color": "#FF9BD2"},
    "BaseN": {"text-color": "#FF9BD2"},
    "Float": {"text-color": "#FF9BD2"},
    "Constant": {"text-color": "#FF9BD2"},
    "Comment": {"text-color": "#A9C8E8", "italic": true},
    "Documentation": {"text-color": "#A9C8E8", "italic": true},
    "CommentVar": {"text-color": "#A9C8E8", "bold": true, "italic": true},
    "Annotation": {"text-color": "#A9C8E8", "bold": true, "italic": true},
    "Attribute": {"text-color": "#FFE36E"},
    "Preprocessor": {"text-color": "#FF9BD2"},
    "Information": {"text-color": "#A9C8E8", "bold": true, "italic": true},
    "Warning": {"text-color": "#FFE36E", "bold": true, "italic": true},
    "Alert": {"text-color": "#FF9BD2", "bold": true},
    "Error": {"text-color": "#FF9BD2", "bold": true, "underline": true},
    "RegionMarker": {"text-color": "#A9C8E8"}
  }
}
